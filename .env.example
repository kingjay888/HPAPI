# HP Catalog Service API (Hermes) - recommended for official product images
# Register at: https://syndication.inc.hp.com/content/serviceAPI/us/en/index.html
HP_CATALOG_BASE_URL=https://hpit-gw.hpcloud.hp.com/generic-router/api/hermes
HP_CATALOG_REQUESTER_ID=
HP_CATALOG_CLIENT_CERT=/path/to/client-cert.pem
HP_CATALOG_CLIENT_KEY=/path/to/client-key.pem

# HP API credentials (Basic auth — no OAuth token exchange required)
HP_CATALOG_CLIENT_ID=
HP_CATALOG_CLIENT_SECRET=

# Locale
HP_COUNTRY_CODE=US
HP_LANGUAGE_CODE=en

# Fallback HP Shop search.
# Set HP_SHOP_ENABLED=false if HP blocks your server's IP — the scrape can then
# only ever time out, and skipping it removes that delay from every lookup.
HP_SHOP_BASE_URL=https://www.hp.com/us-en/shop
HP_SHOP_ENABLED=true

# Timeouts and concurrency.
# REQUEST_TIMEOUT_SECONDS applies to ONE upstream call; a product makes up to
# five, so keep it small or a single request stretches into minutes and the
# browser drops the connection ("Failed to fetch").
REQUEST_TIMEOUT_SECONDS=15
# Hard ceiling for all work on one product. Exceeding it marks that product as
# timed out instead of stalling the whole batch.
PRODUCT_TIMEOUT_SECONDS=40
# Products looked up simultaneously. Raise to finish sooner, lower if HP
# rate-limits you.
MAX_CONCURRENCY=5

# Set to DEBUG for verbose upstream diagnostics in journalctl.
LOG_LEVEL=INFO
