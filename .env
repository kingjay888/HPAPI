# HP Catalog Service API (Hermes) - recommended for official product images
# Register at: https://syndication.inc.hp.com/content/serviceAPI/us/en/index.html
HP_CATALOG_BASE_URL=https://hpit-gw.hpcloud.hp.com/generic-router/api/hermes
HP_CATALOG_REQUESTER_ID=
HP_CATALOG_CLIENT_CERT=
HP_CATALOG_CLIENT_KEY=


# HP API credentials.
# NOTE: the hpit-gw gateway rejects Basic with 401 "Invalid token" — it wants a
# JWT bearer token. Blocked pending HP's answer; see HP_SUPPORT_REQUEST.md.
# When they reply, set HP_CATALOG_AUTH_MODE / HP_CATALOG_TOKEN_URL below.
HP_CATALOG_CLIENT_ID=Vh3PuhDJZ13dzMEgu8pCBMKHoejrwCSY
HP_CATALOG_CLIENT_SECRET=jV4espqCvhfPiOzl5XiRORUh1wmNyp7q

# Locale
HP_COUNTRY_CODE=US
HP_LANGUAGE_CODE=en

# Fallback HP Shop search.
# Disabled: HP tarpits this AWS instance (ReadTimeout every call), so the scrape
# can only ever burn a full timeout. Re-enable if running from an unblocked network.
HP_SHOP_BASE_URL=https://www.hp.com/us-en/shop
HP_SHOP_ENABLED=false

# Timeouts and concurrency.
REQUEST_TIMEOUT_SECONDS=15
PRODUCT_TIMEOUT_SECONDS=40
MAX_CONCURRENCY=5

# Gateway auth: get a token from HP ID, then call productcontent with Bearer.
HP_CATALOG_AUTH_MODE=oauth2
HP_CATALOG_API_KEY_HEADER=x-api-key
HP_CATALOG_API_KEY_VALUE=
HP_CATALOG_TOKEN_URL=https://core.api.hp.com/hpid/oauth/v1/token
HP_CATALOG_OAUTH_SCOPE=

LOG_LEVEL=INFO
